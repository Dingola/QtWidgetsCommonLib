@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Widgets Svg Sql)
find_dependency(QtCommonLib REQUIRED)

include(${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@.cmake)

if(TARGET @PROJECT_NAME@ AND NOT TARGET @PROJECT_NAME@::@PROJECT_NAME@)
    add_library(@PROJECT_NAME@::@PROJECT_NAME@ ALIAS @PROJECT_NAME@)
endif()

check_required_components(@PROJECT_NAME@)

message(STATUS "@PROJECT_NAME@ found.")
